{
  "name": "shifttrack-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "emulators": "firebase emulators:start --only auth --project demo-shifttrack",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && NODE_ENV=production vite build --config apps/web/vite.config.ts && tsc -p apps/api/tsconfig.json",
    "build:local": "npm run typecheck && NODE_ENV=production vite build --mode development --config apps/web/vite.config.ts && tsc -p apps/api/tsconfig.json",
    "test": "tsx --env-file=.env --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node dist/apps/api/src/server.js",
    "worker:tick": "tsx --env-file=.env apps/worker/tick.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "contracts": "tsx --env-file=.env scripts/openapi.ts",
    "format": "prettier --write apps packages scripts tests docs README.md *.json playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@google-cloud/storage": "8.2.0",
    "argon2": "0.45.1",
    "dexie": "4.4.6",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "lucide-react": "1.51.0",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "firebase-tools": "15.32.1",
    "prettier": "3.9.9",
    "smtp-server": "3.19.17",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
