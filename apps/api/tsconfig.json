  "compilerOptions": {
    "outDir": "../../dist",
    "rootDir": "../..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  "include": [
